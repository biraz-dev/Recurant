{
  "type": "object",
  "required": [
    "schema_version",
    "theme_id",
    "title",
    "manifest_base",
    "geometry_manifest",
    "material_bindings",
    "asset_recipe",
    "assembly",
    "runtime_integration_verified"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "theme_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "manifest_base": {
      "type": "string"
    },
    "geometry_manifest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]+:).+"
    },
    "material_bindings": {
      "type": "object",
      "required": [
        "wall",
        "ground",
        "structure",
        "detail"
      ],
      "properties": {
        "wall": {
          "$ref": "#/$defs/material"
        },
        "ground": {
          "$ref": "#/$defs/material"
        },
        "structure": {
          "$ref": "#/$defs/material"
        },
        "detail": {
          "$ref": "#/$defs/material"
        }
      }
    },
    "asset_recipe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "role"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "required": [
        "route"
      ],
      "properties": {
        "route": {
          "enum": [
            "instances",
            "assembled_glb",
            "recipe_only"
          ]
        },
        "layout": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]+:).+"
        },
        "glb": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]+:).+"
        },
        "preview": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]+:).+"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "runtime_integration_verified": {
      "type": "boolean"
    },
    "originality_notes": {
      "type": "string"
    },
    "qa": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed normalized theme assembly manifest",
  "description": "Adapter target; raw material-worker manifests may need normalization.",
  "$defs": {
    "material": {
      "type": "object",
      "required": [
        "basecolor",
        "color_space",
        "uv_mode"
      ],
      "properties": {
        "basecolor": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]+:).+"
        },
        "color_space": {
          "const": "sRGB"
        },
        "uv_mode": {
          "enum": [
            "tile_repeat_2m",
            "panel_clamp_0_1"
          ]
        },
        "normal": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]+:).+"
        },
        "orm": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]+:).+"
        },
        "alpha_mode": {
          "enum": [
            "OPAQUE",
            "MASK",
            "BLEND"
          ]
        },
        "alpha_cutoff": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
